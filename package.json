{
  "name": "prism",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "npm run dev --workspace=@prism/landing",
    "dev:app": "npm run dev --workspace=@prism/app",
    "dev:admin": "npm run dev --workspace=@prism/admin",
    "dev:borrow": "npm run dev --workspace=@prism/borrow",
    "build:landing": "npm run build --workspace=@prism/landing",
    "build:app": "npm run build --workspace=@prism/app",
    "build:admin": "npm run build --workspace=@prism/admin",
    "build:borrow": "npm run build --workspace=@prism/borrow",
    "lint": "npm run lint --workspaces --if-present"
  }
}
